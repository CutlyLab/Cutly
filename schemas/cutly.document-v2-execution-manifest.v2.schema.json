{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutly.dev/schemas/cutly.document-v2-execution-manifest.v2.schema.json",
  "title": "Document v2 Execution Manifest v2",
  "description": "Frozen plan-scoped execution identity, not authorization, proof of resource bytes, an installed implementation, or an execution receipt. Exact closure, canonical bytes, sorted sets and cross-field fingerprints require the strict Go verifier. All collections are required and non-null. References resolve through the offline published schema registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "canonical_json_profile", "plan_fingerprint", "semantic_profile", "document_hash", "compiler_build", "evaluator_build", "provider_build", "resources", "backend", "media_runtime", "output", "visual", "audio", "deterministic_seed", "fingerprint"],
  "properties": {
    "schema_version": {"const": 2},
    "profile": {"const": "cutly.execution-manifest.document-v2.v2"},
    "canonical_json_profile": {"const": "cutly.json.canonical-integer.v1"},
    "plan_fingerprint": {"$ref": "#/$defs/hash"},
    "semantic_profile": {"const": "cutly.semantic.document-v2-render-plan.v1"},
    "document_hash": {"$ref": "#/$defs/hash"},
    "compiler_build": {"$ref": "#/$defs/hash"},
    "evaluator_build": {"$ref": "#/$defs/hash"},
    "provider_build": {"$ref": "#/$defs/hash"},
    "resources": {"$ref": "#/$defs/resources"},
    "backend": {"$ref": "#/$defs/backend"},
    "media_runtime": {"$ref": "#/$defs/mediaRuntime"},
    "output": {"$ref": "#/$defs/output"},
    "visual": {"oneOf": [{"$ref": "#/$defs/disabled"}, {"$ref": "#/$defs/visualEnabled"}]},
    "audio": {"oneOf": [{"$ref": "#/$defs/disabled"}, {"$ref": "#/$defs/audioEnabled"}]},
    "deterministic_seed": {"type": "integer", "minimum": 0, "maximum": 0},
    "fingerprint": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonBlank": {"type": "string", "minLength": 1, "maxLength": 1048576, "pattern": "\\S"},
    "dimension": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "positiveInt64": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "id": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/id"},
    "ticks": {"allOf": [{"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/ticks"}, {"properties": {"count": {"$ref": "#/$defs/positiveInt64"}}}]},
    "frameClock": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/target/properties/frame_clock"},
    "sampleClock": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/target/properties/sample_clock"},
    "resources": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"$ref": "#/$defs/resource"}},
    "resource": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "kind", "content_hash", "size_bytes", "locator_scheme", "locator", "materialization_profile"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["video", "audio", "image", "font"]},
        "content_hash": {"$ref": "#/$defs/hash"}, "size_bytes": {"$ref": "#/$defs/positiveInt64"},
        "locator_scheme": {"enum": ["cas", "file"]}, "locator": {"$ref": "#/$defs/nonBlank"},
        "materialization_profile": {"enum": ["cutly.materialized.document-v2.probed-av.v2", "cutly.materialized.document-v2.inspected-image.v2", "cutly.materialized.document-v2.inspected-font.v2"]},
        "probe_fingerprint": {"$ref": "#/$defs/hash"}, "inspection_fingerprint": {"$ref": "#/$defs/hash"}
      },
      "oneOf": [
        {"required": ["probe_fingerprint"], "not": {"required": ["inspection_fingerprint"]}, "properties": {"kind": {"enum": ["video", "audio"]}, "materialization_profile": {"const": "cutly.materialized.document-v2.probed-av.v2"}}},
        {"required": ["inspection_fingerprint"], "not": {"required": ["probe_fingerprint"]}, "properties": {"kind": {"const": "image"}, "materialization_profile": {"const": "cutly.materialized.document-v2.inspected-image.v2"}}},
        {"required": ["inspection_fingerprint"], "not": {"required": ["probe_fingerprint"]}, "properties": {"kind": {"const": "font"}, "materialization_profile": {"const": "cutly.materialized.document-v2.inspected-font.v2"}}}
      ],
      "allOf": [
        {"if": {"properties": {"locator_scheme": {"const": "cas"}}}, "then": {"properties": {"locator": {"pattern": "^cas://sha256/[0-9a-f]{64}$"}}}},
        {"if": {"properties": {"locator_scheme": {"const": "file"}}}, "then": {"properties": {"locator": {"pattern": "^/", "not": {"pattern": "(^|/)\\.\\.?(/|$)"}}}}}
      ]
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["backend_id", "build_fingerprint", "track_kinds", "asset_kinds", "features", "max_width", "max_height"],
      "properties": {
        "backend_id": {"$ref": "#/$defs/nonBlank"}, "build_fingerprint": {"$ref": "#/$defs/hash"},
        "track_kinds": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"enum": ["video", "audio", "text", "vector"]}},
        "asset_kinds": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"enum": ["video", "audio", "image", "font", "data", "text", "vector"]}},
        "features": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"type": "string", "maxLength": 1048576, "pattern": "^[a-z0-9][a-z0-9._-]*\\.v[1-9][0-9]*$"}},
        "max_width": {"$ref": "#/$defs/dimension"}, "max_height": {"$ref": "#/$defs/dimension"}
      }
    },
    "mediaRuntime": {
      "type": "object", "additionalProperties": false,
      "required": ["ffmpeg_build", "decoder_profile", "encoder_profile", "color_profile"],
      "properties": {
        "ffmpeg_build": {"$ref": "#/$defs/hash"}, "decoder_profile": {"$ref": "#/$defs/nonBlank"},
        "encoder_profile": {"$ref": "#/$defs/nonBlank"}, "color_profile": {"$ref": "#/$defs/nonBlank"}, "text_shaper_build": {"$ref": "#/$defs/hash"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_profile", "format", "width", "height", "pixel_format", "color_space", "video_codec", "audio_codec", "frame_clock", "sample_clock", "sample_rate", "channels", "intermediate", "decoded_video_profile", "decoded_audio_profile"],
      "properties": {
        "reference_profile": {"const": "cutly.output.document-v2.v2"}, "format": {"$ref": "#/$defs/nonBlank"},
        "width": {"$ref": "#/$defs/dimension"}, "height": {"$ref": "#/$defs/dimension"}, "channels": {"$ref": "#/$defs/dimension"},
        "pixel_format": {"$ref": "#/$defs/nonBlank"}, "color_space": {"$ref": "#/$defs/nonBlank"},
        "video_codec": {"$ref": "#/$defs/nonBlank"}, "audio_codec": {"$ref": "#/$defs/nonBlank"},
        "frame_clock": {"$ref": "#/$defs/frameClock"}, "sample_clock": {"$ref": "#/$defs/sampleClock"}, "sample_rate": {"$ref": "#/$defs/positiveInt64"},
        "intermediate": {
          "type": "object", "additionalProperties": false, "required": ["video_surface_profile", "audio_block_profile"],
          "properties": {"video_surface_profile": {"const": "cutly.surface.linear-bt709-premultiplied-rgba16.v1"}, "audio_block_profile": {"const": "cutly.decoded-audio.pcm-s16le.interleaved.v1"}}
        },
        "decoded_video_profile": {"const": "cutly.decoded-video.rgba8.interleaved.top-down.tight.v1"},
        "decoded_audio_profile": {"const": "cutly.decoded-audio.pcm-s16le.interleaved.v1"}
      }
    },
    "disabled": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"const": false}}},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "profile", "descriptor", "descriptor_fingerprint", "configuration", "configuration_fingerprint", "source_manifest", "source_manifest_fingerprint"],
      "properties": {
        "enabled": {"const": true}, "profile": {"$ref": "#/$defs/nonBlank"}, "descriptor": {"$ref": "#/$defs/descriptor"},
        "descriptor_fingerprint": {"$ref": "#/$defs/hash"}, "configuration": {"type": "object"},
        "configuration_fingerprint": {"$ref": "#/$defs/hash"}, "source_manifest": {"$ref": "#/$defs/sourceManifest"}, "source_manifest_fingerprint": {"$ref": "#/$defs/hash"}
      }
    },
    "visualEnabled": {
      "allOf": [{"$ref": "#/$defs/selection"}],
      "properties": {
        "profile": {"enum": ["cutly.program.document-v2.plan-visual.v2", "cutly.program.document-v2.transparent-gap.v2"]},
        "descriptor": {"properties": {"domain": {"const": "visual"}, "configuration_profile": {"const": "cutly.program-config.document-v2.visual.v2"}, "output_profile": {"const": "cutly.surface.linear-bt709-premultiplied-rgba16.v1"}}},
        "configuration": {"$ref": "#/$defs/visualConfiguration"},
        "source_manifest": {"properties": {"domain": {"const": "visual"}, "audio_bus_ids": {"maxItems": 0}}}
      },
      "oneOf": [
        {"properties": {"profile": {"const": "cutly.program.document-v2.transparent-gap.v2"}, "descriptor": {"properties": {"profile": {"const": "cutly.program.document-v2.transparent-gap.v2"}, "contribution": {"const": "transparent-gap"}}}, "source_manifest": {"properties": {"program_profile": {"const": "cutly.program.document-v2.transparent-gap.v2"}, "clips": {"maxItems": 0}, "transitions": {"maxItems": 0}, "resources": {"maxItems": 0}}}}},
        {"properties": {"profile": {"const": "cutly.program.document-v2.plan-visual.v2"}, "descriptor": {"properties": {"profile": {"const": "cutly.program.document-v2.plan-visual.v2"}, "contribution": {"const": "ordered-plan-visual-and-transition-participants"}}}, "source_manifest": {"properties": {"program_profile": {"const": "cutly.program.document-v2.plan-visual.v2"}}, "anyOf": [{"properties": {"clips": {"minItems": 1}}}, {"properties": {"transitions": {"minItems": 1}}}]}}}
      ]
    },
    "audioEnabled": {
      "allOf": [{"$ref": "#/$defs/selection"}],
      "properties": {
        "profile": {"enum": ["cutly.program.document-v2.plan-audio.v2", "cutly.program.document-v2.silence.v2"]},
        "descriptor": {"properties": {"domain": {"const": "audio"}, "configuration_profile": {"const": "cutly.program-config.document-v2.audio.v2"}, "output_profile": {"const": "cutly.decoded-audio.pcm-s16le.interleaved.v1"}}},
        "configuration": {"$ref": "#/$defs/audioConfiguration"},
        "source_manifest": {"properties": {"domain": {"const": "audio"}, "transitions": {"maxItems": 0}}}
      },
      "oneOf": [
        {"properties": {"profile": {"const": "cutly.program.document-v2.silence.v2"}, "descriptor": {"properties": {"profile": {"const": "cutly.program.document-v2.silence.v2"}, "contribution": {"const": "silence"}}}, "source_manifest": {"properties": {"program_profile": {"const": "cutly.program.document-v2.silence.v2"}, "clips": {"maxItems": 0}, "resources": {"maxItems": 0}}}}},
        {"properties": {"profile": {"const": "cutly.program.document-v2.plan-audio.v2"}, "descriptor": {"properties": {"profile": {"const": "cutly.program.document-v2.plan-audio.v2"}, "contribution": {"const": "ordered-plan-audio-and-bus-closure"}}}, "source_manifest": {"properties": {"program_profile": {"const": "cutly.program.document-v2.plan-audio.v2"}, "clips": {"minItems": 1}}}}}
      ]
    },
    "descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "domain", "configuration_profile", "source_manifest_profile", "output_profile", "contribution"],
      "properties": {
        "schema_version": {"const": 2}, "profile": {"enum": ["cutly.program.document-v2.plan-visual.v2", "cutly.program.document-v2.transparent-gap.v2", "cutly.program.document-v2.plan-audio.v2", "cutly.program.document-v2.silence.v2"]},
        "domain": {"enum": ["visual", "audio"]}, "configuration_profile": {"enum": ["cutly.program-config.document-v2.visual.v2", "cutly.program-config.document-v2.audio.v2"]},
        "source_manifest_profile": {"const": "cutly.program-source-manifest.document-v2.v2"},
        "output_profile": {"enum": ["cutly.surface.linear-bt709-premultiplied-rgba16.v1", "cutly.decoded-audio.pcm-s16le.interleaved.v1"]},
        "contribution": {"enum": ["ordered-plan-visual-and-transition-participants", "transparent-gap", "ordered-plan-audio-and-bus-closure", "silence"]}
      }
    },
    "visualConfiguration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "width", "height", "frame_clock", "frame_range", "surface_profile"],
      "properties": {
        "schema_version": {"const": 2}, "profile": {"const": "cutly.program-config.document-v2.visual.v2"},
        "width": {"$ref": "#/$defs/dimension"}, "height": {"$ref": "#/$defs/dimension"},
        "frame_clock": {"$ref": "#/$defs/frameClock"}, "frame_range": {"$ref": "#/$defs/ticks"}, "surface_profile": {"const": "cutly.surface.linear-bt709-premultiplied-rgba16.v1"}
      }
    },
    "audioConfiguration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "sample_clock", "sample_range", "channels", "block_profile"],
      "properties": {
        "schema_version": {"const": 2}, "profile": {"const": "cutly.program-config.document-v2.audio.v2"},
        "sample_clock": {"$ref": "#/$defs/sampleClock"}, "sample_range": {"$ref": "#/$defs/ticks"}, "channels": {"$ref": "#/$defs/dimension"}, "block_profile": {"const": "cutly.decoded-audio.pcm-s16le.interleaved.v1"}
      }
    },
    "sourceManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "canonical_json_profile", "document_hash", "plan_fingerprint", "domain", "program_profile", "descriptor_fingerprint", "configuration_fingerprint", "requested_range", "tick_range", "clips", "transitions", "audio_bus_ids", "resources"],
      "properties": {
        "schema_version": {"const": 2}, "profile": {"const": "cutly.program-source-manifest.document-v2.v2"}, "canonical_json_profile": {"const": "cutly.json.canonical-integer.v1"},
        "document_hash": {"$ref": "#/$defs/hash"}, "plan_fingerprint": {"$ref": "#/$defs/hash"}, "domain": {"enum": ["visual", "audio"]},
        "program_profile": {"enum": ["cutly.program.document-v2.plan-visual.v2", "cutly.program.document-v2.transparent-gap.v2", "cutly.program.document-v2.plan-audio.v2", "cutly.program.document-v2.silence.v2"]},
        "descriptor_fingerprint": {"$ref": "#/$defs/hash"}, "configuration_fingerprint": {"$ref": "#/$defs/hash"}, "requested_range": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/range"}, "tick_range": {"$ref": "#/$defs/ticks"},
        "clips": {"type": "array", "maxItems": 16384, "items": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/clip"}},
        "transitions": {"type": "array", "maxItems": 16384, "items": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json#/$defs/transition"}},
        "audio_bus_ids": {"type": "array", "maxItems": 16384, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "resources": {"$ref": "#/$defs/resources"}
      }
    }
  }
}
