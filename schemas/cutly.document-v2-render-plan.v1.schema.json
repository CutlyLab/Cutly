{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cutly.dev/document-v2-render-plan/v1",
  "title": "Cutly Document v2 Semantic RenderPlan v1",
  "description": "Backend-neutral, URI-free semantic closure for one exact range of a committed Document v2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "canonical_json_profile",
    "hash_profile",
    "document_id",
    "revision",
    "document_hash",
    "timeline_id",
    "requested_range",
    "target",
    "frame_range",
    "sample_range",
    "required_capabilities",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "cutly.semantic.document-v2-render-plan.v1"},
    "canonical_json_profile": {"const": "cutly.json.canonical-integer.v1"},
    "hash_profile": {"const": "cutly.hash.sha256.document-v2-render-plan-canonical-json.v1"},
    "document_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "document_hash": {"$ref": "#/$defs/digest"},
    "timeline_id": {"$ref": "#/$defs/id"},
    "requested_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
    "target": {"$ref": "https://schemas.cutly.dev/render-plan/v3#/$defs/renderTarget"},
    "frame_range": {"$ref": "https://schemas.cutly.dev/render-plan/v3#/$defs/tickRange"},
    "sample_range": {"$ref": "https://schemas.cutly.dev/render-plan/v3#/$defs/tickRange"},
    "required_capabilities": {"$ref": "#/$defs/capabilityRequirements"},
    "visual": {"type": "array", "maxItems": 1048576, "items": {"$ref": "#/$defs/plannedClip"}},
    "audio": {"type": "array", "maxItems": 1048576, "items": {"$ref": "#/$defs/plannedClip"}},
    "transitions": {"type": "array", "maxItems": 1048576, "items": {"$ref": "#/$defs/plannedTransition"}},
    "resources": {"type": "array", "maxItems": 1048576, "items": {"$ref": "#/$defs/resourceRef"}},
    "fingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "\\S", "maxLength": 4096},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "trackKind": {"enum": ["video", "audio", "text", "vector"]},
    "assetKind": {"enum": ["video", "audio", "image", "font", "data", "text", "vector"]},
    "externalAssetKind": {"enum": ["video", "audio", "image", "font", "data"]},
    "capabilityRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track_kinds": {
          "type": "array",
          "maxItems": 1048576,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/trackKind"}
        },
        "asset_kinds": {
          "type": "array",
          "maxItems": 1048576,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/assetKind"}
        },
        "features": {
          "type": "array",
          "maxItems": 1048576,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.v[1-9][0-9]*$", "maxLength": 256}
        }
      }
    },
    "plannedClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id", "clip_id", "asset_id", "track_kind", "asset_kind",
        "track_index", "clip_index", "timeline_range", "source_range",
        "visible_timeline_range", "visible_source_range"
      ],
      "properties": {
        "track_id": {"$ref": "#/$defs/id"},
        "clip_id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "track_kind": {"$ref": "#/$defs/trackKind"},
        "asset_kind": {"$ref": "#/$defs/assetKind"},
        "track_index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "clip_index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "timeline_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
        "source_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
        "visible_timeline_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
        "visible_source_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"}
      }
    },
    "transitionSide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "track_id", "clip_id", "asset_id", "track_kind", "asset_kind",
        "track_index", "clip_index", "selected_source_range"
      ],
      "properties": {
        "track_id": {"$ref": "#/$defs/id"},
        "clip_id": {"$ref": "#/$defs/id"},
        "asset_id": {"$ref": "#/$defs/id"},
        "track_kind": {"$ref": "#/$defs/trackKind"},
        "asset_kind": {"$ref": "#/$defs/assetKind"},
        "track_index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "clip_index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "selected_source_range": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"}
      }
    },
    "plannedTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id", "profile", "transition_index", "pre_duration", "post_duration",
        "window", "selected_window", "outgoing", "incoming"
      ],
      "properties": {
        "transition_id": {"$ref": "#/$defs/id"},
        "profile": {"enum": ["cutly.transition.dissolve.v1", "cutly.transition.fade.v1", "cutly.transition.wipe.v1"]},
        "transition_index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "pre_duration": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/rationalTime"},
        "post_duration": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/rationalTime"},
        "window": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
        "selected_window": {"$ref": "https://schemas.cutly.dev/document/v1#/$defs/positiveTimeRange"},
        "outgoing": {"$ref": "#/$defs/transitionSide"},
        "incoming": {"$ref": "#/$defs/transitionSide"}
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "kind": {"$ref": "#/$defs/externalAssetKind"},
        "content_hash": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
