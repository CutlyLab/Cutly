{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cutly.dev/cutly.document-v2-transaction.v2.schema.json",
  "title": "Cutly Document v2 Transaction",
  "$comment": "Additive S7a, number-preserving profile; not the legacy integer-only canonical JSON profile. Decode additionally requires exact Document canonical bytes, unique object members and operation IDs, valid UTF-8/surrogates, byte/depth/node/string budgets, integer token spelling, digest correctness, matching target/value IDs and split IDs. Apply checks document/revision/hash binding, scopes/references, current positions, postimage expectations, partitions and final Document validity atomically. JSON Schema cannot enforce those requirements; maxLength counts Unicode characters, not UTF-8 bytes. Referenced Document schemas describe typed payload semantics, not standalone transaction authorization or proof of applicability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "id", "idempotency_key", "document_id", "expected_revision", "expected_document_hash", "operations"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 2, "maximum": 2, "const": 2},
    "profile": {"const": "cutly.transaction.document-v2.number-preserving.v2"},
    "id": {"$ref": "#/$defs/id"},
    "idempotency_key": {"$ref": "#/$defs/id"},
    "document_id": {"$ref": "#/$defs/id"},
    "expected_revision": {"$ref": "cutly.document.v2.schema.json#/$defs/revision"},
    "expected_document_hash": {"$ref": "#/$defs/hash"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/operation"}},
    "digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "position": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "expect": {"type": "object", "additionalProperties": false, "required": ["hash"], "properties": {"hash": {"$ref": "#/$defs/hash"}}},
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/assetAdd"}, {"$ref": "#/$defs/assetRemove"}, {"$ref": "#/$defs/assetReplace"},
        {"$ref": "#/$defs/timelineAdd"}, {"$ref": "#/$defs/timelineRemove"}, {"$ref": "#/$defs/timelineReplace"},
        {"$ref": "#/$defs/trackAdd"}, {"$ref": "#/$defs/trackRemove"}, {"$ref": "#/$defs/trackReplace"},
        {"$ref": "#/$defs/clipAdd"}, {"$ref": "#/$defs/clipRemove"}, {"$ref": "#/$defs/clipReplace"},
        {"$ref": "#/$defs/busAdd"}, {"$ref": "#/$defs/busRemove"}, {"$ref": "#/$defs/busReplace"},
        {"$ref": "#/$defs/clipMove"}, {"$ref": "#/$defs/clipTrim"}, {"$ref": "#/$defs/clipSplit"},
        {"$ref": "#/$defs/clipRetrack"}, {"$ref": "#/$defs/clipDelete"}, {"$ref": "#/$defs/clipSetDisabled"}, {"$ref": "#/$defs/clipSetAsset"},
        {"$ref": "#/$defs/propertySet"}, {"$ref": "#/$defs/laneSet"}, {"$ref": "#/$defs/laneRemove"},
        {"$ref": "#/$defs/transitionSet"}, {"$ref": "#/$defs/transitionRemove"}, {"$ref": "#/$defs/trackRoute"},
        {"$ref": "#/$defs/metadataSet"}, {"$ref": "#/$defs/metadataRemove"}, {"$ref": "#/$defs/annotationSet"}, {"$ref": "#/$defs/annotationRemove"}
      ]
    },
    "assetWrite": {"type": "object", "additionalProperties": false, "required": ["asset_id", "position", "value"], "properties": {"asset_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/asset"}}},
    "assetErase": {"type": "object", "additionalProperties": false, "required": ["asset_id"], "properties": {"asset_id": {"$ref": "#/$defs/id"}}},
    "timelineWrite": {"type": "object", "additionalProperties": false, "required": ["timeline_id", "position", "value"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/timeline"}}},
    "timelineErase": {"type": "object", "additionalProperties": false, "required": ["timeline_id"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}}},
    "trackWrite": {"type": "object", "additionalProperties": false, "required": ["timeline_id", "track_id", "position", "value"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}, "track_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/track"}}},
    "trackErase": {"type": "object", "additionalProperties": false, "required": ["timeline_id", "track_id"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}, "track_id": {"$ref": "#/$defs/id"}}},
    "clipWrite": {"type": "object", "additionalProperties": false, "required": ["track_id", "clip_id", "position", "value"], "properties": {"track_id": {"$ref": "#/$defs/id"}, "clip_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/clip"}}},
    "clipErase": {"type": "object", "additionalProperties": false, "required": ["track_id", "clip_id"], "properties": {"track_id": {"$ref": "#/$defs/id"}, "clip_id": {"$ref": "#/$defs/id"}}},
    "busWrite": {"type": "object", "additionalProperties": false, "required": ["bus_id", "position", "value"], "properties": {"bus_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/audioBus"}}},
    "busErase": {"type": "object", "additionalProperties": false, "required": ["bus_id"], "properties": {"bus_id": {"$ref": "#/$defs/id"}}},
    "moveEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "at"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "at": {"$ref": "cutly.document.v2.schema.json#/$defs/rationalTime"}}},
    "trimEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "timeline_range", "source_range"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "timeline_range": {"$ref": "cutly.document.v2.schema.json#/$defs/timeRange"}, "source_range": {"$ref": "cutly.document.v2.schema.json#/$defs/timeRange"}}},
    "splitEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "at", "left", "right"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "at": {"$ref": "cutly.document.v2.schema.json#/$defs/rationalTime"}, "left": {"$ref": "cutly.document.v2.schema.json#/$defs/clip"}, "right": {"$ref": "cutly.document.v2.schema.json#/$defs/clip"}}},
    "retrackEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "track_id", "position"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "track_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}}},
    "disabledEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "disabled"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "disabled": {"type": "boolean"}}},
    "assetReferenceEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id", "asset_id"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "asset_id": {"$ref": "#/$defs/id"}}},
    "propertiesEdit": {"type": "object", "additionalProperties": false, "required": ["clip_id"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/propertySet"}}},
    "laneWrite": {"type": "object", "additionalProperties": false, "required": ["clip_id", "lane_id", "position", "value"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "lane_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/keyframeLane"}}},
    "laneErase": {"type": "object", "additionalProperties": false, "required": ["clip_id", "lane_id"], "properties": {"clip_id": {"$ref": "#/$defs/id"}, "lane_id": {"$ref": "#/$defs/id"}}},
    "transitionWrite": {"type": "object", "additionalProperties": false, "required": ["timeline_id", "transition_id", "position", "value"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}, "transition_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/transition"}}},
    "transitionErase": {"type": "object", "additionalProperties": false, "required": ["timeline_id", "transition_id"], "properties": {"timeline_id": {"$ref": "#/$defs/id"}, "transition_id": {"$ref": "#/$defs/id"}}},
    "routeEdit": {"type": "object", "additionalProperties": false, "required": ["track_id", "bus_id"], "properties": {"track_id": {"$ref": "#/$defs/id"}, "bus_id": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/id"}]}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["document", "asset", "timeline", "track", "clip"]}, "id": {"$ref": "#/$defs/id"}}},
    "metadataWrite": {"type": "object", "additionalProperties": false, "required": ["scope", "key", "value"], "properties": {"scope": {"$ref": "#/$defs/scope"}, "key": {"type": "string", "minLength": 1}, "value": {}}},
    "metadataErase": {"type": "object", "additionalProperties": false, "required": ["scope", "key"], "properties": {"scope": {"$ref": "#/$defs/scope"}, "key": {"type": "string", "minLength": 1}}},
    "annotationWrite": {"type": "object", "additionalProperties": false, "required": ["scope", "annotation_id", "position", "value"], "properties": {"scope": {"$ref": "#/$defs/scope"}, "annotation_id": {"$ref": "#/$defs/id"}, "position": {"$ref": "#/$defs/position"}, "value": {"$ref": "cutly.document.v2.schema.json#/$defs/annotation"}}},
    "annotationErase": {"type": "object", "additionalProperties": false, "required": ["scope", "annotation_id"], "properties": {"scope": {"$ref": "#/$defs/scope"}, "annotation_id": {"$ref": "#/$defs/id"}}},
    "assetAdd": {"type": "object", "additionalProperties": false, "required": ["id", "op", "asset"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "asset_add"}, "expect": {"$ref": "#/$defs/expect"}, "asset": {"$ref": "#/$defs/assetWrite"}}},
    "assetRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "asset"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "asset_remove"}, "expect": {"$ref": "#/$defs/expect"}, "asset": {"$ref": "#/$defs/assetErase"}}},
    "assetReplace": {"type": "object", "additionalProperties": false, "required": ["id", "op", "asset"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "asset_replace"}, "expect": {"$ref": "#/$defs/expect"}, "asset": {"$ref": "#/$defs/assetWrite"}}},
    "timelineAdd": {"type": "object", "additionalProperties": false, "required": ["id", "op", "timeline"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "timeline_add"}, "expect": {"$ref": "#/$defs/expect"}, "timeline": {"$ref": "#/$defs/timelineWrite"}}},
    "timelineRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "timeline"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "timeline_remove"}, "expect": {"$ref": "#/$defs/expect"}, "timeline": {"$ref": "#/$defs/timelineErase"}}},
    "timelineReplace": {"type": "object", "additionalProperties": false, "required": ["id", "op", "timeline"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "timeline_replace"}, "expect": {"$ref": "#/$defs/expect"}, "timeline": {"$ref": "#/$defs/timelineWrite"}}},
    "trackAdd": {"type": "object", "additionalProperties": false, "required": ["id", "op", "track"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "track_add"}, "expect": {"$ref": "#/$defs/expect"}, "track": {"$ref": "#/$defs/trackWrite"}}},
    "trackRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "track"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "track_remove"}, "expect": {"$ref": "#/$defs/expect"}, "track": {"$ref": "#/$defs/trackErase"}}},
    "trackReplace": {"type": "object", "additionalProperties": false, "required": ["id", "op", "track"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "track_replace"}, "expect": {"$ref": "#/$defs/expect"}, "track": {"$ref": "#/$defs/trackWrite"}}},
    "clipAdd": {"type": "object", "additionalProperties": false, "required": ["id", "op", "clip"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_add"}, "expect": {"$ref": "#/$defs/expect"}, "clip": {"$ref": "#/$defs/clipWrite"}}},
    "clipRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "clip"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_remove"}, "expect": {"$ref": "#/$defs/expect"}, "clip": {"$ref": "#/$defs/clipErase"}}},
    "clipReplace": {"type": "object", "additionalProperties": false, "required": ["id", "op", "clip"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_replace"}, "expect": {"$ref": "#/$defs/expect"}, "clip": {"$ref": "#/$defs/clipWrite"}}},
    "busAdd": {"type": "object", "additionalProperties": false, "required": ["id", "op", "bus"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "bus_add"}, "expect": {"$ref": "#/$defs/expect"}, "bus": {"$ref": "#/$defs/busWrite"}}},
    "busRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "bus"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "bus_remove"}, "expect": {"$ref": "#/$defs/expect"}, "bus": {"$ref": "#/$defs/busErase"}}},
    "busReplace": {"type": "object", "additionalProperties": false, "required": ["id", "op", "bus"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "bus_replace"}, "expect": {"$ref": "#/$defs/expect"}, "bus": {"$ref": "#/$defs/busWrite"}}},
    "clipMove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "move"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_move"}, "expect": {"$ref": "#/$defs/expect"}, "move": {"$ref": "#/$defs/moveEdit"}}},
    "clipTrim": {"type": "object", "additionalProperties": false, "required": ["id", "op", "trim"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_trim"}, "expect": {"$ref": "#/$defs/expect"}, "trim": {"$ref": "#/$defs/trimEdit"}}},
    "clipSplit": {"type": "object", "additionalProperties": false, "required": ["id", "op", "split"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_split"}, "expect": {"$ref": "#/$defs/expect"}, "split": {"$ref": "#/$defs/splitEdit"}}},
    "clipRetrack": {"type": "object", "additionalProperties": false, "required": ["id", "op", "retrack"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_retrack"}, "expect": {"$ref": "#/$defs/expect"}, "retrack": {"$ref": "#/$defs/retrackEdit"}}},
    "clipDelete": {"type": "object", "additionalProperties": false, "required": ["id", "op", "clip"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_delete"}, "expect": {"$ref": "#/$defs/expect"}, "clip": {"$ref": "#/$defs/clipErase"}}},
    "clipSetDisabled": {"type": "object", "additionalProperties": false, "required": ["id", "op", "disabled"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_set_disabled"}, "expect": {"$ref": "#/$defs/expect"}, "disabled": {"$ref": "#/$defs/disabledEdit"}}},
    "clipSetAsset": {"type": "object", "additionalProperties": false, "required": ["id", "op", "asset_reference"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "clip_set_asset"}, "expect": {"$ref": "#/$defs/expect"}, "asset_reference": {"$ref": "#/$defs/assetReferenceEdit"}}},
    "propertySet": {"type": "object", "additionalProperties": false, "required": ["id", "op", "properties"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "property_set"}, "expect": {"$ref": "#/$defs/expect"}, "properties": {"$ref": "#/$defs/propertiesEdit"}}},
    "laneSet": {"type": "object", "additionalProperties": false, "required": ["id", "op", "lane"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "lane_set"}, "expect": {"$ref": "#/$defs/expect"}, "lane": {"$ref": "#/$defs/laneWrite"}}},
    "laneRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "lane"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "lane_remove"}, "expect": {"$ref": "#/$defs/expect"}, "lane": {"$ref": "#/$defs/laneErase"}}},
    "transitionSet": {"type": "object", "additionalProperties": false, "required": ["id", "op", "transition"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "transition_set"}, "expect": {"$ref": "#/$defs/expect"}, "transition": {"$ref": "#/$defs/transitionWrite"}}},
    "transitionRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "transition"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "transition_remove"}, "expect": {"$ref": "#/$defs/expect"}, "transition": {"$ref": "#/$defs/transitionErase"}}},
    "trackRoute": {"type": "object", "additionalProperties": false, "required": ["id", "op", "route"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "track_route"}, "expect": {"$ref": "#/$defs/expect"}, "route": {"$ref": "#/$defs/routeEdit"}}},
    "metadataSet": {"type": "object", "additionalProperties": false, "required": ["id", "op", "metadata"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "metadata_set"}, "expect": {"$ref": "#/$defs/expect"}, "metadata": {"$ref": "#/$defs/metadataWrite"}}},
    "metadataRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "metadata"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "metadata_remove"}, "expect": {"$ref": "#/$defs/expect"}, "metadata": {"$ref": "#/$defs/metadataErase"}}},
    "annotationSet": {"type": "object", "additionalProperties": false, "required": ["id", "op", "annotation"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "annotation_set"}, "expect": {"$ref": "#/$defs/expect"}, "annotation": {"$ref": "#/$defs/annotationWrite"}}},
    "annotationRemove": {"type": "object", "additionalProperties": false, "required": ["id", "op", "annotation"], "properties": {"id": {"$ref": "#/$defs/id"}, "op": {"const": "annotation_remove"}, "expect": {"$ref": "#/$defs/expect"}, "annotation": {"$ref": "#/$defs/annotationErase"}}}
  }
}
