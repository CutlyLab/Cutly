{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutly.dev/schemas/cutly.prepared-environment.document-v2.v2.schema.json",
  "title": "Cutly Prepared Environment Document v2",
  "description": "An owned durable snapshot, not host authorization. Document number spellings retain the Document v2 canonical contract; embedded plan and manifest retain their own canonical profiles. Exact canonical bytes, resource admission, hash equality and semantic cross-bindings are enforced by the Go codec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "canonical_json_profile", "document_hash", "plan_fingerprint", "execution_manifest_fingerprint", "document", "plan", "execution_manifest"],
  "properties": {
    "schema_version": {"const": 2},
    "profile": {"const": "cutly.render.prepared-environment.v2"},
    "canonical_json_profile": {"const": "cutly.json.prepared-document-v2-number-preserving.v1"},
    "document_hash": {"$ref": "#/$defs/digest"},
    "plan_fingerprint": {"$ref": "#/$defs/digest"},
    "execution_manifest_fingerprint": {"$ref": "#/$defs/digest"},
    "document": {"$ref": "https://schemas.cutly.dev/cutly.document.v2.schema.json"},
    "plan": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-render-plan.v1.schema.json"},
    "execution_manifest": {"$ref": "https://cutly.dev/schemas/cutly.document-v2-execution-manifest.v2.schema.json"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
