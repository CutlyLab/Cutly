{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cutly.dev/cutly.project-plan.document-v2.v2.schema.json",
  "title": "Cutly Document v2 project plan record",
  "description": "Immutable number-preserving local project record. Schema validation proves shape only; service admission recomputes the transaction and inverse against stored snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transaction", "digest", "base_document_hash", "candidate_document_hash", "inverse", "impact"],
  "properties": {
    "version": {"type": "integer", "const": 2, "minimum": 2, "maximum": 2},
    "transaction": {"$ref": "cutly.document-v2-transaction.v2.schema.json"},
    "digest": {"$ref": "#/$defs/hash"},
    "base_document_hash": {"$ref": "#/$defs/hash"},
    "candidate_document_hash": {"$ref": "#/$defs/hash"},
    "inverse": {"$ref": "cutly.document-v2-transaction.v2.schema.json"},
    "impact": {"$ref": "#/$defs/impact"},
    "reverts_transaction_id": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_changed", "visual", "audio", "render_required", "timeline_ids"],
      "oneOf": [
        {"properties": {"render_required": {"const": false}, "visual": {"const": false}, "audio": {"const": false}}},
        {"properties": {"render_required": {"const": true}}, "anyOf": [{"properties": {"visual": {"const": true}}}, {"properties": {"audio": {"const": true}}}]}
      ],
      "properties": {
        "identity_changed": {"type": "boolean", "const": true},
        "visual": {"type": "boolean"},
        "audio": {"type": "boolean"},
        "render_required": {"type": "boolean"},
        "timeline_ids": {"type": "array", "maxItems": 2000000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
