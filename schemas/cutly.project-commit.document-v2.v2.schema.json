{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cutly.dev/cutly.project-commit.document-v2.v2.schema.json",
  "title": "Cutly Document v2 project commit record",
  "description": "Immutable history entry; intrinsic record checks do not replace plan replay and history-chain validation by the local project service.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sequence", "plan_hash", "transaction_id", "idempotency_key", "digest", "base_revision", "new_revision", "base_document_hash", "new_document_hash", "inverse", "impact"],
  "properties": {
    "version": {"type": "integer", "const": 2, "minimum": 2, "maximum": 2},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "plan_hash": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/hash"},
    "transaction_id": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/id"},
    "idempotency_key": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/id"},
    "digest": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/hash"},
    "base_revision": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/revision"},
    "new_revision": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/revision"},
    "base_document_hash": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/hash"},
    "new_document_hash": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/hash"},
    "inverse": {"$ref": "cutly.document-v2-transaction.v2.schema.json"},
    "impact": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/impact"},
    "reverts_transaction_id": {"$ref": "cutly.project-plan.document-v2.v2.schema.json#/$defs/id"}
  }
}
