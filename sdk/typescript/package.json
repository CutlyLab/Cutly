{
  "name": "@cutly/sdk",
  "version": "0.1.0-rc.1",
  "description": "Typed protocol and headless client bindings for Cutly",
  "type": "module",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CutlyLab/Cutly.git",
    "directory": "sdk/typescript"
  },
  "publishConfig": {
    "access": "public"
  }
}
